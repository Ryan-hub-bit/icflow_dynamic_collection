ARG BASE_IMAGE=icflow-dynamic-collection:prebuilt
FROM ${BASE_IMAGE}

USER root

ARG MINICONDA_INSTALLER=Miniconda3-py311_26.7.1-1-Linux-x86_64.sh
ARG MINICONDA_SHA256=a6f98e6e19d5b7897ae887cd6af931eb863459f86ffd1a09cc370124cab0993e

ENV CONDA_DIR=/opt/conda \
    CONDA_PLUGINS_AUTO_ACCEPT_TOS=yes \
    PIP_NO_CACHE_DIR=1

COPY graphenv.yml /opt/icflownet-e1/graphenv.yml

RUN pacman -Sy --noconfirm --needed rust \
    && curl -fsSL --retry 3 \
      "https://repo.anaconda.com/miniconda/${MINICONDA_INSTALLER}" \
      -o /tmp/miniconda.sh \
    && echo "${MINICONDA_SHA256}  /tmp/miniconda.sh" | sha256sum -c - \
    && bash /tmp/miniconda.sh -b -p "$CONDA_DIR" \
    && "$CONDA_DIR/bin/conda" env create \
      --file /opt/icflownet-e1/graphenv.yml \
    && "$CONDA_DIR/bin/conda" clean --all --yes \
    && pacman -Rns --noconfirm rust \
    && pacman -Scc --noconfirm \
    && rm -rf /root/.cache/pip /root/.cargo /tmp/miniconda.sh \
    && rm -f /tmp/pyvex_ffi_parser_cache.*

COPY --chown=icflow:icflow e1/icflownet /workspace/icflownet
COPY --chown=icflow:icflow e1/run_e1.sh e1/verify_e1.py /opt/icflownet-e1/

ENV ICFLOWNET_ROOT=/workspace/icflownet \
    GRAPH_PYTHON=/opt/conda/envs/graph/bin/python \
    PALMTREE_USE_CUDA=0 \
    PATH=/opt/conda/envs/graph/bin:/opt/conda/bin:${PATH}

RUN chmod 0755 /opt/icflownet-e1/run_e1.sh /opt/icflownet-e1/verify_e1.py \
    && mkdir -p /output \
    && chown icflow:icflow /output \
    && test -x "$LLVM_BUILD/bin/clang++" \
    && test -x "$LLVM_BUILD/bin/llvm-nm" \
    && test -x "$LLVM_BUILD/bin/ld.lld" \
    && test -x "$PIN_ROOT/pin" \
    && test -f "$PINTOOL" \
    && test -f "$ICFLOWNET_ROOT/src/groundtruth/static/palmtree/vocab" \
    && test -f "$ICFLOWNET_ROOT/src/groundtruth/static/palmtree/transformer.ep19"

USER icflow

RUN bash -n /opt/icflownet-e1/run_e1.sh \
    && PALMTREE_USE_CUDA=0 "$GRAPH_PYTHON" -c \
      'import angr, dgl, torch; print(angr.__version__, dgl.__version__, torch.__version__)'

WORKDIR /workspace/icflow_dynamic_collection

CMD ["/opt/icflownet-e1/run_e1.sh", "--help"]
